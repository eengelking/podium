{
  "name": "podium-site",
  "private": true,
  "type": "module",
  "description": "The Podium docs site (Astro Starlight). It reads ../docs and is built by scripts/build.mjs, one build per released version.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:latest": "node scripts/build.mjs --latest-only",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "astro": "7.4.4",
    "starlight-links-validator": "0.27.0"
  }
}
