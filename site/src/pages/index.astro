---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ChatIcon from "../components/ChatIcon.astro";
import { base, discordUrl, docsHome, repoUrl } from "../components/siteMeta";
import { SITE_ORIGIN } from "../../docs-nav.mjs";

const description =
  "Podium shows each agent session's model, cost, context and branch, the agents it launched, and why anything failed, on one screen. It watches and never types into a terminal.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Podium",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux",
  description,
  url: SITE_ORIGIN,
  license: "https://opensource.org/licenses/MIT",
  codeRepository: repoUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const arrow = "M4 10h11M11 5l5 5-5 5";
---

<StarlightPage
  frontmatter={{
    title: "See every agent session on one screen",
    description,
    template: "splash",
    banner: process.env.DOCS_REF ? { content: "Older version" } : undefined,
    head: [{ tag: "script", attrs: { type: "application/ld+json" }, content: JSON.stringify(structuredData) }],
  }}
>
  <div class="home not-content">
    <section class="stage">
      <div class="band-back" aria-hidden="true"></div>
      <div class="hero">
        <div class="wrap hero-grid">
          <div>
            <h1>See every agent session on one screen.</h1>
            <p class="lede">
              Podium shows each session's model, cost, context and branch, the agents it launched, and why anything failed. Run several sessions
              without clicking through every terminal.
            </p>
            <div class="acts">
              <a class="cta solid" href={`${base}user-guide/`}>Get started</a>
              <a class="cta ghost" href={docsHome}>Read the docs</a>
              <a class="cta ghost" href={discordUrl} target="_blank" rel="noopener"><ChatIcon />Join the Discord<span class="sr-only"> (opens Discord)</span></a>
            </div>
            <p class="join">Stuck on setup? <a href={discordUrl} target="_blank" rel="noopener">Ask in the Discord</a> and get an answer from people who run Podium.</p>
          </div>

          <div class="art-wrap">
            <!-- The sky is its own layer, so its animation never repaints the console graphic above it. -->
            <svg class="sky" viewBox="0 0 600 480" aria-hidden="true" focusable="false">
              <defs><radialGradient id="pl-hot" cx=".35" cy=".3" r=".85"><stop offset="0" style="stop-color:color-mix(in srgb, var(--hero-ink) 55%, var(--hot))"></stop><stop offset=".55" style="stop-color:var(--hot)"></stop><stop offset="1" style="stop-color:color-mix(in srgb, var(--hero-b) 50%, var(--hot))"></stop></radialGradient><radialGradient id="pl-gold" cx=".35" cy=".3" r=".85"><stop offset="0" style="stop-color:color-mix(in srgb, var(--hero-ink) 55%, var(--hero-mark))"></stop><stop offset=".55" style="stop-color:var(--hero-mark)"></stop><stop offset="1" style="stop-color:color-mix(in srgb, var(--hero-b) 50%, var(--hero-mark))"></stop></radialGradient><radialGradient id="pl-green" cx=".35" cy=".3" r=".85"><stop offset="0" style="stop-color:color-mix(in srgb, var(--hero-ink) 55%, var(--ok))"></stop><stop offset=".55" style="stop-color:var(--ok)"></stop><stop offset="1" style="stop-color:color-mix(in srgb, var(--hero-b) 50%, var(--ok))"></stop></radialGradient></defs>
              <circle class="glow" cx="300" cy="252" r="250"></circle>
              <g class="stars">
                <g transform="translate(70 168)"><path class="tw" style="--t:4.2s;--d:-0.6s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(548 214) scale(0.8)"><path class="tw" style="--t:3.4s;--d:-1.9s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(520 438) scale(1.1)"><path class="tw" style="--t:5.1s;--d:-3.2s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(222 52) scale(0.7)"><path class="tw" style="--t:3.8s;--d:-2.4s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(36 392) scale(0.6)"><path class="tw" style="--t:4.6s;--d:-0.2s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(588 330) scale(0.55)"><path class="tw" style="--t:3.1s;--d:-1.1s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <g transform="translate(330 24) scale(0.5)"><path class="tw" style="--t:4.9s;--d:-2.9s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
                <circle class="tw dotstar" cx="168" cy="446" r="3" style="--t:3.6s;--d:-0.9s"></circle><circle class="tw dotstar" cx="578" cy="130" r="3" style="--t:4.4s;--d:-2.1s"></circle><circle class="tw dotstar" cx="36" cy="300" r="2.5" style="--t:3.2s;--d:-1.4s"></circle>
                <circle class="tw dotstar" cx="110" cy="30" r="2" style="--t:5.2s;--d:-3.4s"></circle><circle class="tw dotstar" cx="470" cy="20" r="1.8" style="--t:3.9s;--d:-0.4s"></circle><circle class="tw dotstar" cx="8" cy="220" r="1.8" style="--t:4.7s;--d:-2.6s"></circle>
                <circle class="tw dotstar" cx="596" cy="60" r="1.6" style="--t:3.3s;--d:-1.7s"></circle><circle class="tw dotstar" cx="402" cy="468" r="2" style="--t:4.1s;--d:-3s"></circle><circle class="tw dotstar" cx="250" cy="470" r="1.6" style="--t:5s;--d:-0.7s"></circle>
              </g>
              <g class="spin outer"><circle class="orbit" cx="300" cy="252" r="285"></circle><g transform="translate(585 252)"><g class="keep"><ellipse class="ring" rx="42" ry="11.5" transform="rotate(-24)"></ellipse><circle class="pl hot" r="21"></circle><path class="ring" d="M-42 0A42 11.5 0 0 0 42 0" transform="rotate(-24)"></path></g></g></g>
              <g class="spin middle"><circle class="orbit" cx="300" cy="252" r="232"></circle><g class="keep"><circle class="pl green" cx="68" cy="252" r="11"></circle></g></g>
              <g class="spin inner"><circle class="orbit" cx="300" cy="252" r="176"></circle><g class="keep"><circle class="pl gold" cx="124" cy="252" r="16"></circle></g><circle class="moon" cx="146" cy="232" r="4"></circle></g>
            </svg>
            <svg
              class="art"
              viewBox="0 0 600 480"
              role="img"
              aria-label="An illustration of the Podium console: one orchestrator above three sessions, one running, one waiting on a person and one failed, with a cost, a context level, a git branch and a failure floating around it."
            >
              <g class="shadowed">
                <rect class="card" x="90" y="110" width="420" height="300" rx="18"></rect>
                <rect class="sunk" x="90" y="110" width="420" height="36" rx="18"></rect>
                <rect class="sunk" x="90" y="128" width="420" height="18"></rect>
                <circle cx="112" cy="128" r="5" style="fill:var(--bad)"></circle><circle cx="128" cy="128" r="5" style="fill:var(--warn)"></circle><circle cx="144" cy="128" r="5" style="fill:var(--ok)"></circle>
                <rect class="card" x="200" y="119" width="200" height="18" rx="9"></rect>
                <text class="mono2" x="300" y="131.5" text-anchor="middle">podium.engelking.dev:4317</text>

                <circle cx="300" cy="178" r="13" style="fill:var(--accent)"></circle>
                <circle cx="300" cy="178" r="5" style="fill:var(--accent-ink)"></circle>
                <text class="st" x="322" y="182">orchestrator, 3 agents</text>
                <path class="ln" d="M300 191V206H169V224M300 191V224M300 191V206H431V224"></path>

                <rect class="sunk" x="108" y="224" width="122" height="170" rx="12"></rect>
                <text class="mono" x="120" y="248">feat/chat</text>
                <circle cx="124" cy="266" r="4.5" style="fill:var(--ok)"></circle><text class="st" x="134" y="270">running</text>
                <text class="lab" x="120" y="296">context</text><text class="lab" x="206" y="296" text-anchor="end">62%</text>
                <rect class="track" x="120" y="302" width="98" height="6" rx="3"></rect><rect x="120" y="302" width="61" height="6" rx="3" style="fill:var(--accent)"></rect>
                <text class="big" x="120" y="338">$4.18</text><text class="lab" x="120" y="354">estimated</text>
                <circle cx="124" cy="376" r="5" style="fill:var(--accent)"></circle><circle cx="142" cy="376" r="5" style="fill:var(--ok)"></circle><circle cx="160" cy="376" r="5" style="fill:var(--mute)"></circle>

                <rect class="sunk" x="239" y="224" width="122" height="170" rx="12" style="stroke:var(--warn);stroke-width:1.6"></rect>
                <text class="mono" x="251" y="248">fix/login</text>
                <path d="M255 261.5l4.5 4.5-4.5 4.5-4.5-4.5z" style="fill:var(--warn)"></path><text class="st" x="265" y="270">waiting on you</text>
                <text class="lab" x="251" y="296">context</text><text class="lab" x="337" y="296" text-anchor="end">88%</text>
                <rect class="track" x="251" y="302" width="98" height="6" rx="3"></rect><rect x="251" y="302" width="86" height="6" rx="3" style="fill:var(--warn)"></rect>
                <text class="big" x="251" y="338">$2.07</text><text class="lab" x="251" y="354">estimated</text>
                <circle cx="255" cy="376" r="5" style="fill:var(--accent)"></circle><circle cx="273" cy="376" r="5" style="fill:var(--warn)"></circle>

                <rect class="sunk" x="370" y="224" width="122" height="170" rx="12" style="stroke:var(--bad);stroke-width:1.6"></rect>
                <text class="mono" x="382" y="248">docs-site</text>
                <path d="M382 262l8 8m0-8l-8 8" style="stroke:var(--bad);stroke-width:2;stroke-linecap:round;fill:none"></path><text class="st" x="396" y="270">failed</text>
                <text class="lab" x="382" y="296">context</text><text class="lab" x="468" y="296" text-anchor="end">31%</text>
                <rect class="track" x="382" y="302" width="98" height="6" rx="3"></rect><rect x="382" y="302" width="30" height="6" rx="3" style="fill:var(--accent)"></rect>
                <text class="big" x="382" y="338">$0.64</text><text class="lab" x="382" y="354">estimated</text>
                <circle cx="386" cy="376" r="5" style="fill:var(--bad)"></circle>
              </g>
            </svg>
            <!-- The floating chips are HTML layers that only move, so the browser animates them smoothly. -->
            <div class="chip" style="--x:14;--y:56;--w:150;--h:50;--t:7s;--d:0s" aria-hidden="true">
              <svg viewBox="0 0 30 30"><circle cx="15" cy="15" r="13" style="fill:var(--hot)"></circle><text x="15" y="20" text-anchor="middle" style="font:700 15px var(--sans);fill:var(--accent-ink)">$</text></svg>
              <span><span class="lbl">Fleet cost</span><span class="val">$6.89</span></span>
            </div>
            <div class="chip" style="--x:436;--y:44;--w:152;--h:56;--t:8s;--d:-2.5s" aria-hidden="true">
              <svg viewBox="0 0 30 30"><circle cx="15" cy="15" r="12" fill="none" style="stroke:var(--line);stroke-width:4.5"></circle><circle cx="15" cy="15" r="12" fill="none" style="stroke:var(--warn);stroke-width:4.5;stroke-linecap:round;stroke-dasharray:66 10;transform:rotate(-90deg);transform-origin:15px 15px"></circle><text x="15" y="18" text-anchor="middle" style="font:700 8px var(--sans);fill:var(--ink)">88%</text></svg>
              <span><span class="lbl">Context window</span><span class="val small">almost full</span></span>
            </div>
            <div class="chip" style="--x:8;--y:360;--w:178;--h:44;--t:7.5s;--d:-4s" aria-hidden="true">
              <svg viewBox="0 0 30 30" fill="none" stroke-width="1.8" stroke-linecap="round" style="stroke:var(--accent)"><circle cx="9" cy="7" r="3"></circle><circle cx="9" cy="23" r="3"></circle><circle cx="21" cy="11" r="3"></circle><path d="M9 10v10M21 14c0 6-12 3-12 6"></path></svg>
              <span class="mono">feat/chat ↑2 ~5</span>
            </div>
            <div class="chip bad" style="--x:412;--y:396;--w:180;--h:50;--t:6.5s;--d:-1.5s" aria-hidden="true">
              <svg viewBox="0 0 30 30" fill="none" stroke-width="2.4" stroke-linecap="round" style="stroke:var(--bad)"><path d="M8 8l14 14M22 8L8 22"></path></svg>
              <span><span class="mono">npm test</span><span class="mono2">exit 1, 3 failed</span></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sect">
      <div class="wrap split">
        <div class="head">
          <h2>What you see for every session</h2>
          <div class="rule"></div>
          <p class="sub">Each session appears within about two seconds of its first prompt and leaves when it ends, with no refresh.</p>
        </div>
        <div class="feats">
          <div class="feat">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M14.8 9.2c-.6-1-1.6-1.4-2.8-1.4-1.6 0-2.7.8-2.7 2 0 3 5.6 1.3 5.6 4.2 0 1.2-1.1 2-2.9 2-1.3 0-2.4-.5-3-1.5M12 6.2v1.6M12 16.2v1.6"></path></svg></div>
            <h3>Cost</h3>
            <p>An estimate from token counts and a price table you can change in Admin. It is never a bill.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16a8 8 0 1 1 16 0"></path><path d="M12 16l4-5"></path><circle cx="12" cy="16" r="1.2"></circle></svg></div>
            <h3>Context</h3>
            <p>How full each context window is, and how often one blew out.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 16H3z"></path><path d="M12 10v4M12 17.2v.2"></path></svg></div>
            <h3>Failures</h3>
            <p>Why an agent or a tool call failed, and which session it belongs to.</p>
          </div>
          <div class="feat">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="5.5" r="2.3"></circle><circle cx="7" cy="18.5" r="2.3"></circle><circle cx="17" cy="8.5" r="2.3"></circle><path d="M7 7.8v8.4M17 10.8c0 4.4-10 2.4-10 5.4"></path></svg></div>
            <h3>Branch</h3>
            <p>The git branch or worktree each session works in, and whether it has uncommitted changes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sect alt">
      <div class="wrap">
        <div class="head center">
          <h2>The console</h2>
          <div class="rule"></div>
          <p class="sub">Run several sessions without clicking through every terminal. The console runs on your machine and updates as sessions change.</p>
        </div>
        <figure class="shotfig">
          <!-- The same sky as the hero's, wider and in the accent color, behind the console frame. It is its own layer, with no filters. -->
          <svg class="sky wide" viewBox="0 0 1400 900" aria-hidden="true" focusable="false">
            <circle class="glow" cx="700" cy="450" r="520"></circle>
            <g class="stars">
              <g transform="translate(60 120)"><path class="tw" style="--t:4.2s;--d:-0.6s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(1330 90) scale(0.8)"><path class="tw" style="--t:3.4s;--d:-1.9s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(110 780) scale(0.9)"><path class="tw" style="--t:5.1s;--d:-3.2s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(1290 820) scale(1.1)"><path class="tw" style="--t:3.8s;--d:-2.4s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
              <g transform="translate(330 60) scale(0.7)"><path class="tw" style="--t:4.6s;--d:-0.2s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(1050 40) scale(0.6)"><path class="tw" style="--t:3.1s;--d:-1.1s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(640 860) scale(0.8)"><path class="tw" style="--t:4.9s;--d:-2.9s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(1380 450) scale(0.6)"><path class="tw" style="--t:3.7s;--d:-0.9s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
              <g transform="translate(20 450) scale(0.7)"><path class="tw" style="--t:4.4s;--d:-2.2s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(800 90) scale(0.5)"><path class="tw" style="--t:5.3s;--d:-3.5s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g><g transform="translate(420 830) scale(0.6)"><path class="tw" style="--t:3.5s;--d:-1.5s" d="M0-9 L2.2-2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2-2.2Z"></path></g>
              <circle class="tw dotstar" cx="200" cy="40" r="3" style="--t:3.6s;--d:-0.9s"></circle><circle class="tw dotstar" cx="1180" cy="110" r="3" style="--t:4.4s;--d:-2.1s"></circle><circle class="tw dotstar" cx="90" cy="300" r="2.5" style="--t:3.2s;--d:-1.4s"></circle><circle class="tw dotstar" cx="1310" cy="300" r="2.5" style="--t:4.8s;--d:-0.3s"></circle>
              <circle class="tw dotstar" cx="230" cy="880" r="2.2" style="--t:5.2s;--d:-3.4s"></circle><circle class="tw dotstar" cx="980" cy="860" r="2.2" style="--t:3.9s;--d:-0.4s"></circle><circle class="tw dotstar" cx="40" cy="640" r="2" style="--t:4.7s;--d:-2.6s"></circle><circle class="tw dotstar" cx="1360" cy="640" r="2" style="--t:3.3s;--d:-1.7s"></circle>
              <circle class="tw dotstar" cx="520" cy="30" r="2" style="--t:4.1s;--d:-3s"></circle><circle class="tw dotstar" cx="760" cy="880" r="1.8" style="--t:5s;--d:-0.7s"></circle><circle class="tw dotstar" cx="1240" cy="520" r="1.8" style="--t:3.8s;--d:-2.3s"></circle><circle class="tw dotstar" cx="150" cy="520" r="1.8" style="--t:4.5s;--d:-1.2s"></circle>
            </g>
              <g class="spin outer"><circle class="orbit" cx="700" cy="450" r="620"></circle><g transform="translate(1320 450)"><g class="keep"><ellipse class="ring" rx="62" ry="17" transform="rotate(-24)"></ellipse><circle class="pl hot" r="32"></circle><path class="ring" d="M-62 0A62 17 0 0 0 62 0" transform="rotate(-24)"></path></g></g></g>
              <g class="spin middle"><circle class="orbit" cx="700" cy="450" r="500"></circle><g class="keep"><circle class="pl green" cx="200" cy="450" r="16"></circle></g></g>
              <g class="spin inner"><circle class="orbit" cx="700" cy="450" r="380"></circle><g class="keep"><circle class="pl gold" cx="320" cy="450" r="24"></circle></g><circle class="moon" cx="352" cy="420" r="6"></circle></g>
            </svg>
          <div class="browser">
            <div class="bar">
              <i></i><i></i><i></i>
              <span class="addr"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="7" height="5" rx="1"></rect><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5"></path></svg>podium.engelking.dev:4317</span>
            </div>
            <img
              src={`${base}images/podium-chaos.png`}
              width="1914"
              height="960"
              alt="The Podium console showing nine simulated agent sessions with their models, cost, context bars and the activity feed"
            />
          </div>
          <figcaption class="cap">Nine simulated sessions: running, stale and failing, with the activity feed on the right.</figcaption>
        </figure>
      </div>
    </section>

    <section class="sect">
      <div class="wrap">
        <div class="head center">
          <h2>Start in three steps</h2>
          <div class="rule"></div>
          <p class="sub">Podium is a server and a reporter for your coding harness. You run both yourself.</p>
        </div>
        <div class="steps">
          <div class="step">
            <div class="txt">
              <div class="num">1</div>
              <h3>Start the server</h3>
              <p>It builds on first use and runs on your machine.</p>
            </div>
            <pre>git clone https://github.com/eengelking/podium.git
cd podium &amp;&amp; npm link
podiumctl start</pre>
          </div>
          <div class="step">
            <div class="txt">
              <div class="num">2</div>
              <h3>Install the reporter</h3>
