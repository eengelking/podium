# Server
PORT=4317
HOST=127.0.0.1

# Podium fleet console
# SQLite file (default: data/podium.sqlite in the repo)
PODIUM_DB=
# Home directory shown as ~ in session paths (default: the server's own home; podiumctl sets it in a container)
PODIUM_HOST_HOME=
# The admin secret. When set, POST /api/fleet/report, POST /api/fleet/hook and DELETE require the X-Podium-Token
# header (this, or a person's token made in Admin), and it opens the Admin section. Empty turns auth and Admin off.
PODIUM_TOKEN=
STALE_AFTER_MS=15000
HOOK_STALE_AFTER_MS=600000
DROP_AFTER_MS=60000
LINGER_MS=8000
# Retention: chart samples 24 h, events 30 days, ended sessions 30 days, Admin log 90 days, daily rollups 395 days
RETAIN_SAMPLES_MS=86400000
RETAIN_EVENTS_MS=2592000000
RETAIN_SESSIONS_MS=2592000000
RETAIN_ADMIN_LOG_MS=7776000000
RETAIN_ROLLUP_MS=34128000000

# Logging: debug, info, warn or error (debug adds one line per HTTP request); text or json
PODIUM_LOG_LEVEL=info
PODIUM_LOG_FORMAT=text
# Also push the JSON lines to a central platform, e.g. VictoriaLogs at http://HOST:9428 (empty: nothing is sent)
PODIUM_LOG_SHIP_URL=
# Headers for that endpoint, Name=Value;Name2=Value2 (auth, AccountID). Never printed.
PODIUM_LOG_SHIP_HEADERS=
# Lines kept while the endpoint is down; the oldest are dropped past this
PODIUM_LOG_SHIP_BUFFER=2000

# Built-in TLS: on opens a mutual-TLS port for reporters (default 4318); the console stays on HTTP
PODIUM_TLS=off
PODIUM_TLS_PORT=4318
# Failed /api requests one address may make a minute before it gets 429
PODIUM_FAILURE_LIMIT=300

# Running through podiumctl? It keeps these in ~/.podium/config.env instead (podiumctl config set KEY=VALUE).
