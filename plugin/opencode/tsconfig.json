{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@opencode/plugin": ["../../.build-test/opencode-types/node_modules/@opencode/plugin/dist/promise/index.d.ts"],
      "@opencode/plugin/tui": ["../../.build-test/opencode-types/node_modules/@opencode/plugin/dist/tui/index.d.ts"]
    }
  },
  "include": [".", "../core"],
  "exclude": ["**/*.test.ts", "../core/**/*.test.ts"]
}
