#!/usr/bin/env node
// podiumctl: manage the Podium server from the command line, either in a container (Podman or Docker) or as a
// plain Node process on the host. No dependencies; run `podiumctl --help`.
import { spawn, spawnSync } from 'node:child_process';
import { randomBytes } from 'node:crypto';
import fs from 'node:fs';
import net from 'node:net';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

export const REPO_ROOT = path.join(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))), '..');
export const IMAGE = 'localhost/podium:latest';
export const CONTAINER = 'podium';
export const VOLUME = 'podium-data';
export const SERVICE_LABEL = 'dev.podium.server';
const INNER_PORT = 4317;
const INNER_TLS_PORT = 4318;
/** Container engines podiumctl drives, in the order it prefers them when more than one is installed. */
export const ENGINES = ['podman', 'docker'];

/** Server settings podiumctl passes through to the server unchanged when they are set in the config. */
export const PASSTHROUGH = [
  'STALE_AFTER_MS', 'HOOK_STALE_AFTER_MS', 'DROP_AFTER_MS', 'LINGER_MS', 'DETACHED_HIDE_AFTER_MS',
  'RETAIN_SAMPLES_MS', 'RETAIN_EVENTS_MS', 'RETAIN_SESSIONS_MS', 'RETAIN_ADMIN_LOG_MS', 'RETAIN_ROLLUP_MS',
  'TZ', 'PODIUM_ALLOWED_HOSTS', 'PODIUM_TRUST_PROXY', 'PODIUM_FAILURE_LIMIT',
  'PODIUM_LOG_LEVEL', 'PODIUM_LOG_FORMAT', 'PODIUM_LOG_SHIP_URL', 'PODIUM_LOG_SHIP_HEADERS', 'PODIUM_LOG_SHIP_BUFFER',
];
/**
 * Keys podiumctl itself owns. PODIUM_DB is a SQLite file in standalone mode only; a database on the network
 * (`postgres://user:password@host:5432/dbname`) is passed through in either mode. PODIUM_DATA_DIR (the folder for the TLS
 * CA) is standalone-only: the container's is always /data. Container-only: PODIUMCTL_ENGINE.
 */
export const OWN_KEYS = ['PODIUMCTL_MODE', 'PODIUMCTL_ENGINE', 'PODIUMCTL_PORT', 'PODIUMCTL_BIND', 'PODIUM_TOKEN', 'PODIUM_DB', 'PODIUM_DATA_DIR', 'PODIUM_TLS', 'PODIUM_TLS_PORT'];
const ALL_KEYS = [...OWN_KEYS, ...PASSTHROUGH];
/** Keys an older config may still hold. Ignored by the server; `config unset` removes them, `config set` refuses. */
export const RETIRED_KEYS = ['ANTHROPIC_ADMIN_API_KEY'];

const HELP = `podiumctl: manage the Podium server

Usage: podiumctl <command> [options]

Commands:
  build               Build the container image (container mode) or the app (standalone mode)
  start               Start the server; builds first if there is nothing to run yet
  stop                Stop the server (the database is kept)
  restart             Stop, then start (use this after changing the config)
  status              Show mode, state, health, URL and whether it starts on boot, or its boot unit is stale (exit 3 if stopped)
  logs                Print the server log (-f to follow, --tail N for the last N lines)
  health              Exit 0 when the server answers, 1 when it does not
  url                 Print the dashboard URL
  token               Print the admin secret (--rotate makes a new one; restart to apply)
  config              Show the settings; \`config set KEY=VALUE [KEY=VALUE ...]\` and \`config unset KEY [KEY ...]\` change them
  context [verb]      Which Podium server the reporter uses on this machine: list, show, add NAME FILE, rename NAME NEW, remove NAME, use NAME
  enable              Start on boot / login (launchd on macOS, a systemd user unit on Linux)
  disable             Stop starting on boot
  shell               Open a shell in the container (container mode)
  rm [--purge --yes]  Remove the container; --purge --yes also deletes the data and the image
                      --purge-tls --yes also deletes the TLS folder (the CA: every reporter config must then be reissued)
  run                 Run the server in the foreground (what the boot service calls)

Options:
  --mode container|standalone   How to run it (saved; default: container if Podman or Docker is installed)
  --engine podman|docker        Container engine (saved; default: podman if installed, else docker)
  --port N                      Port on this machine (saved; default 4317)
  --bind ADDR                   Address to listen on (saved; default 127.0.0.1)
  --tls                         Turn built-in TLS on (saved as PODIUM_TLS=on; off by default). Turn it off: config set PODIUM_TLS=off
  -f, --follow                  logs: follow
  --tail N                      logs: lines to show (default 100)
  --rotate                      token: generate a new admin secret
  --show-token                  config: print the token, log ship header values and URL password instead of masking them
  -h, --help                    This help

Files (set PODIUMCTL_HOME to move them; default ~/.podium):
  config.env     Settings, one KEY=VALUE per line, mode 0600. Holds the generated token.
  data/          SQLite database (standalone mode); container mode uses the volume "${VOLUME}".
  tls/           The CA and serving certificate when TLS is on (container mode; standalone keeps them in data/tls).
                 Back it up and keep it private: it holds the CA key. rm and rm --purge keep it.
  podium.log     Server log (standalone mode); container mode: \`podiumctl logs\`.
  contexts.json  The reporter's contexts (\`podiumctl context\`): a name for each reporter config file. It is always in ~/.podium, where the
                 reporter reads it, even when PODIUMCTL_HOME moves the other files.

Auth: the first \`start\` generates the admin secret and saves it as PODIUM_TOKEN in config.env. Open the
dashboard (\`podiumctl url\`), go to Admin and sign in with the name Admin and the secret to make a token for each person. On your own machine a reporter can
send the secret itself as X-Podium-Token. Find it any time with \`podiumctl token\`. To run without auth (and
without Admin): \`podiumctl config set PODIUM_TOKEN=\` (empty on purpose).

Built-in TLS (off by default; \`podiumctl start --tls\` or \`podiumctl config set PODIUM_TLS=on\`, then restart):
  PODIUM_TLS            on or off. On: the server makes its own CA and opens a second port for reporters (mutual TLS only); the console stays on HTTP
  PODIUM_TLS_PORT       Reporter port on this machine (mutual TLS, default 4318); the HTTP port is unchanged
                        Container mode publishes it on the --bind address and keeps the CA in ~/.podium/tls

Database (SQLite by default):
  PODIUM_DB             A SQLite file (standalone mode only), or a database on the network, e.g.
                        podiumctl config set PODIUM_DB=postgres://user:password@db.lan:5432/podium, then podiumctl restart.
                        Works in both modes; the container then needs no /data/podium.sqlite. Output shows host:port/dbname
                        only, never the user or the password (\`config\` hides them unless --show-token).
  PODIUM_DATA_DIR       Folder for the TLS CA (standalone mode; default: the folder of the SQLite file, else ~/.podium/data).
                        Container mode always uses /data.

Host names (a page on another site can rebind its name to this machine, so the server refuses a request whose
Host is not one it expects; 127.0.0.1, localhost and [::1] always work, and so does the --bind address):
  PODIUM_ALLOWED_HOSTS  Names (or addresses) other machines type to reach this server, comma-separated, e.g.
                        podiumctl config set PODIUM_ALLOWED_HOSTS=box.lan,fleet.example, then podiumctl restart.
                        With --bind 0.0.0.0 (or ::) any IP address typed in the bar works without being listed;
                        a name always has to be listed. With TLS on, list every name and address reporters use:
                        the serving certificate carries only these, localhost and 127.0.0.1. The port is not compared

Reverse proxy (behind one, every request seems to come from the proxy, so the Admin log shows its address, the lockouts
are shared by everyone and the session cookies are not marked Secure):
  PODIUM_TRUST_PROXY    The proxy hops to believe X-Forwarded-For and X-Forwarded-Proto from: a count (1), addresses
                        or ranges (10.0.0.5,172.16.0.0/12) or loopback, linklocal, uniquelocal. Off by default; "true" is
                        refused. Name only a proxy that overwrites those headers: a hop that passes a client's through
                        lets that client choose its source and defeats the lockouts. Then podiumctl restart
  PODIUM_FAILURE_LIMIT  Failed requests (a response of 400 or more) one address may make a minute before its requests get 429
                        until the minute is over. Default 300; a whole number of at least 1. Behind a proxy that is not named in
                        PODIUM_TRUST_PROXY every client shares one address, so raise it. Then podiumctl restart

Logging (server output; \`podiumctl logs\` shows it):
  PODIUM_LOG_LEVEL         debug, info (default), warn or error. debug adds one line per HTTP request
  PODIUM_LOG_FORMAT        text (default, as before) or json (one JSON object per line)
  PODIUM_LOG_SHIP_URL      Also push every line to this endpoint, e.g. a VictoriaLogs server at
                           http://HOST:9428 (its /insert/jsonline is added). Off when empty
  PODIUM_LOG_SHIP_HEADERS  Headers for that endpoint, Name=Value;Name2=Value2 (auth, AccountID)
  PODIUM_LOG_SHIP_BUFFER   Lines kept while the endpoint is down (default 2000; the oldest go first)
  Example: podiumctl config set PODIUM_LOG_SHIP_URL=http://host.containers.internal:9428
  (in container mode that name reaches this machine under Podman, host.docker.internal under Docker; standalone,
  use 127.0.0.1), then podiumctl restart

Config keys: ${ALL_KEYS.join(', ')}.
`;

// ---------- pure helpers (exported for tests) ----------

export function parseArgs(argv) {
  const flags = {};
  const rest = [];
  const valued = new Set(['mode', 'engine', 'port', 'bind', 'tail']);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-h' || a === '--help') flags.help = true;
    else if (a === '-f') flags.follow = true;
    else if (a.startsWith('--')) {
      const [k, inline] = a.slice(2).split(/=(.*)/s);
      if (valued.has(k)) {
        const v = inline ?? argv[++i];
        if (v === undefined) throw new Error(`--${k} needs a value`);
        flags[k] = v;
      } else flags[k] = inline ?? true;
    } else rest.push(a);
  }
  return { cmd: rest[0], args: rest.slice(1), flags };
}

export function parseEnvFile(text) {
  const out = {};
  for (const line of text.split('\n')) {
    const m = /^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/.exec(line);
    if (m) out[m[1]] = m[2].trim();
  }
  return out;
}

export function serializeEnv(obj) {
  const lines = ['# Managed by podiumctl. Edit with `podiumctl config set KEY=VALUE`.'];
  for (const k of Object.keys(obj)) lines.push(`${k}=${obj[k]}`);
  return lines.join('\n') + '\n';
}

/**
 * Settings after defaults and flags are applied. `installed` lists the container engines on PATH, in ENGINES order; it
 * picks the default mode and engine. `engine` stays undefined when none is named or installed.
 */
export function resolveConfig(file, flags = {}, installed = ['podman']) {
  const mode = flags.mode ?? file.PODIUMCTL_MODE ?? (installed.length ? 'container' : 'standalone');
  if (mode !== 'container' && mode !== 'standalone') throw new Error(`mode must be container or standalone, not "${mode}"`);
  const engine = flags.engine ?? (file.PODIUMCTL_ENGINE || undefined) ?? installed[0];
  if (engine !== undefined && !ENGINES.includes(engine)) throw new Error(`engine must be ${ENGINES.join(' or ')}, not "${engine}"`);
  const port = Number(flags.port ?? file.PODIUMCTL_PORT ?? INNER_PORT);
  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error(`invalid port "${flags.port ?? file.PODIUMCTL_PORT}"`);
  const bind = flags.bind ?? file.PODIUMCTL_BIND ?? '127.0.0.1';
  if (file.PODIUM_TLS !== undefined && !['', 'on', 'off'].includes(file.PODIUM_TLS)) throw new Error(`PODIUM_TLS must be on or off, not "${file.PODIUM_TLS}"`);
  // `--tls` turns it on; `--tls=off` is honored rather than read as a truthy string.
  const tls = flags.tls === undefined ? file.PODIUM_TLS === 'on' : flags.tls !== 'off' && flags.tls !== false;
  const tlsPort = Number(file.PODIUM_TLS_PORT || INNER_TLS_PORT);
  if (!Number.isInteger(tlsPort) || tlsPort < 1 || tlsPort > 65535) throw new Error(`invalid HTTPS port "${file.PODIUM_TLS_PORT}"`);
  if (tls && tlsPort === port) throw new Error(`the HTTPS port and the HTTP port must be different, both are ${port}`);
  return { mode, engine, port, bind, tls, tlsPort, token: file.PODIUM_TOKEN, db: file.PODIUM_DB, dataDir: file.PODIUM_DATA_DIR, extra: Object.fromEntries(PASSTHROUGH.filter((k) => file[k] !== undefined).map((k) => [k, file[k]])) };
}

/** True when PODIUM_DB names a database on the network (`kind://...`) rather than a SQLite file. `sqlite://path` is a file. */
export function isNetworkDb(value) {
  const m = /^([a-z][a-z0-9+.-]*):\/\//.exec(value ?? '');
  return !!m && m[1] !== 'sqlite';
}

/** What a log or a status line may say of a database: `host:port/dbname` for one on the network, never the user or the password. */
export function dbLabel(value) {
  if (!isNetworkDb(value)) return value || '';
  try {
    const u = new URL(value);
    return `${u.host}${u.pathname}`;
  } catch { return '(unreadable PODIUM_DB)'; }
}

/** Environment the server process gets (the token and other settings live here, never on a command line). */
export function serverEnv(cfg, inContainer) {
  const env = { ...cfg.extra };
  // An empty token is deliberate (auth off): pass it through so a stray PODIUM_TOKEN in the shell or .env cannot win.
  if (cfg.token !== undefined) env.PODIUM_TOKEN = cfg.token;
  // The container's own home is /home/node, so the server needs the host's to show session paths as ~/...
  // The container runs in UTC, so without the host's zone "Est. cost today" would restart at UTC midnight (#139).
  if (inContainer) Object.assign(env, { TZ: cfg.extra.TZ ?? Intl.DateTimeFormat().resolvedOptions().timeZone, HOST: '0.0.0.0', PORT: String(INNER_PORT), PODIUM_DB: isNetworkDb(cfg.db) ? cfg.db : '/data/podium.sqlite', PODIUM_DATA_DIR: '/data', PODIUM_HOST_HOME: os.homedir() });
  else Object.assign(env, { HOST: cfg.bind, PORT: String(cfg.port), PODIUM_DB: cfg.db ?? '', ...(cfg.dataDir ? { PODIUM_DATA_DIR: cfg.dataDir } : {}) });
  // Inside the container the HTTPS port is always the image's; the host side is mapped by containerRunArgs.
  // The server writes the port people reach it on into each reporter config, which in a container is the host's (#649).
  if (cfg.tls) Object.assign(env, { PODIUM_TLS: 'on', PODIUM_TLS_PORT: String(inContainer ? INNER_TLS_PORT : cfg.tlsPort), ...(inContainer ? { PODIUM_TLS_PUBLIC_PORT: String(cfg.tlsPort) } : {}) });
  return env;
}

/**
 * `tlsDir` is the host folder that holds the CA; it is mounted at /data/tls only with TLS on, so the CA outlives the
 * container and the volume, and a person can find it and back it up. Podman's :U gives the container's `node` user
 * the folder (rootless Podman maps users); Docker uses the folder as the host user made it.
 */
export function containerRunArgs(cfg, envNames, tlsDir) {
  return [
    'run', '-d', '--name', CONTAINER, '--restart', 'unless-stopped',
    '-p', `${cfg.bind}:${cfg.port}:${INNER_PORT}`,
    ...(cfg.tls ? ['-p', `${cfg.bind}:${cfg.tlsPort}:${INNER_TLS_PORT}`] : []),
    // Podman always maps host.containers.internal to this machine; Docker maps host.docker.internal only on Desktop.
    ...(cfg.engine === 'docker' ? ['--add-host', 'host.docker.internal:host-gateway'] : []),
    '-v', `${VOLUME}:/data`,
    ...(cfg.tls ? ['-v', `${tlsDir}:/data/tls${cfg.engine === 'podman' ? ':U' : ''}`] : []),
    '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges',
    '--health-cmd', `node -e "fetch('http://127.0.0.1:${INNER_PORT}/api/fleet/state').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"`,
    '--health-interval', '30s',
    ...envNames.flatMap((n) => ['-e', n]),
    IMAGE,
  ];
}

/** What to tell a person when the started container has nothing mounted at /data/tls, or null when the CA is on a mount. `mounts` is the engine's `.Mounts`. */
export function tlsStorageWarning(mounts) {
  if (mounts.some((m) => m.Destination === '/data/tls')) return null;
  return 'TLS is on but /data/tls is not on a volume or a bind mount, so recreating the container would lose the CA and every reporter config would need reissuing. Check the container with `podiumctl status`.';
}

/** Homebrew installs node under Cellar/<formula>/<version>, a directory `brew upgrade` deletes; `opt/<formula>` is the link that survives it. */
export function stableNodePath(execPath) {
  return execPath.replace(/^(.*)\/Cellar\/([^/]+)\/[^/]+\/(.*)$/, '$1/opt/$2/$3');
}

export function launchdPlist({ label, args, keepAliveOnFailure, logPath, env }) {
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const envXml = Object.entries(env).map(([k, v]) => `    <key>${esc(k)}</key><string>${esc(v)}</string>`).join('\n');
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${esc(label)}</string>
  <key>ProgramArguments</key>
  <array>
${args.map((a) => `    <string>${esc(a)}</string>`).join('\n')}
  </array>
  <key>RunAtLoad</key><true/>
${keepAliveOnFailure ? '  <key>KeepAlive</key>\n  <dict><key>SuccessfulExit</key><false/></dict>\n' : ''}  <key>EnvironmentVariables</key>
  <dict>
${envXml}
  </dict>
  <key>StandardOutPath</key><string>${esc(logPath)}</string>
  <key>StandardErrorPath</key><string>${esc(logPath)}</string>
</dict>
</plist>
`;
}

export function systemdUnit({ args, stopArgs, standalone, env }) {
  const q = (s) => (/[\s"'\\$%]/.test(s) ? `"${s.replace(/(["\\])/g, '\\$1').replace(/%/g, '%%')}"` : s);
  const envLines = Object.entries(env).map(([k, v]) => `Environment=${q(`${k}=${v}`)}`).join('\n');
  const exec = args.map(q).join(' ');
  return `[Unit]
Description=Podium fleet console
After=network-online.target

[Service]
${standalone ? `Type=simple\nExecStart=${exec}\nRestart=on-failure\nRestartSec=3` : `Type=oneshot\nRemainAfterExit=yes\nExecStart=${exec}\nExecStop=${stopArgs.map(q).join(' ')}`}
${envLines}

[Install]
WantedBy=default.target
`;
}

/** The config as `podiumctl config` prints it: the token, log ship header values and a ship URL's password hidden. */
export function maskConfig(file) {
  const shown = { ...file };
  if (shown.PODIUM_TOKEN) shown.PODIUM_TOKEN = '(hidden; --show-token or `podiumctl token`)';
  if (isNetworkDb(shown.PODIUM_DB)) shown.PODIUM_DB = `${shown.PODIUM_DB.split('://')[0]}://(hidden)@${dbLabel(shown.PODIUM_DB)}`;
  if (shown.PODIUM_LOG_SHIP_HEADERS) {
    shown.PODIUM_LOG_SHIP_HEADERS = shown.PODIUM_LOG_SHIP_HEADERS.split(';').filter((p) => p.trim())
      .map((p) => (p.includes('=') ? `${p.split('=')[0].trim()}=(hidden)` : '(hidden)')).join(';');
  }
  if (shown.PODIUM_LOG_SHIP_URL) {
    try {
      const u = new URL(shown.PODIUM_LOG_SHIP_URL);
      if (u.password) u.password = 'hidden';
      if (u.username) u.username = 'hidden';
      for (const k of [...u.searchParams.keys()]) u.searchParams.set(k, 'hidden');
      if (u.password || u.username || [...u.searchParams.keys()].length) shown.PODIUM_LOG_SHIP_URL = u.toString();
    } catch { /* not a URL: the server says so at start, and there is no password to hide */ }
  }
  return shown;
}

// ---------- environment ----------

const homeDir = () => process.env.PODIUMCTL_HOME || path.join(os.homedir(), '.podium');
const configPath = () => path.join(homeDir(), 'config.env');
const tlsDirPath = () => path.join(homeDir(), 'tls');
const logPath = () => path.join(homeDir(), 'podium.log');
const pidPath = () => path.join(homeDir(), 'podium.pid');

const say = (m) => console.log(m);
/** Prints a secret the person asked for (`token`, `config --show-token`). Kept apart from `say` so nothing else can route a secret into the log (CodeQL js/clear-text-logging). */
const sayRequested = (m) => { process.stdout.write(`${m}\n`); };
class Fail extends Error {}
const fail = (m) => { throw new Fail(m); };

function readConfigFile() {
  try { return parseEnvFile(fs.readFileSync(configPath(), 'utf8')); } catch { return {}; }
}
function writeConfigFile(obj) {
  fs.mkdirSync(homeDir(), { recursive: true });
  fs.writeFileSync(configPath(), serializeEnv(obj), { mode: 0o600 });
  fs.chmodSync(configPath(), 0o600);
}
const installedEngines = () => ENGINES.filter((e) => spawnSync(e, ['--version'], { stdio: 'ignore' }).status === 0);

function loadCfg(flags, { persist }) {
  const file = readConfigFile();
  const cfg = resolveConfig(file, flags, installedEngines());
  if (persist) {
    const next = { ...file, PODIUMCTL_MODE: cfg.mode, PODIUMCTL_PORT: String(cfg.port), PODIUMCTL_BIND: cfg.bind };
    if (flags.tls !== undefined) next.PODIUM_TLS = cfg.tls ? 'on' : 'off';
    // Saved so stop, status and the boot unit keep using the engine that started the container, whatever is installed later.
    if (cfg.mode === 'container' && cfg.engine) next.PODIUMCTL_ENGINE = cfg.engine;
    if (JSON.stringify(next) !== JSON.stringify(file)) writeConfigFile(next);
  }
  return cfg;
}

/** Generate the token on first use (RKE2 style) unless the config deliberately sets it empty. */
function ensureToken(cfg) {
  if (cfg.token !== undefined) return cfg;
  const file = readConfigFile();
  const token = randomBytes(24).toString('hex');
  writeConfigFile({ ...file, PODIUM_TOKEN: token });
  say(`Generated an auth token and saved it to ${configPath()}`);
  say('Show it any time with: podiumctl token');
  return { ...cfg, token };
}

/** The address this machine calls to reach its own server: a wildcard bind is called on loopback, an IPv6 address is bracketed. */
const callHost = (bind) => {
  if (['0.0.0.0', '::', ''].includes(bind)) return '127.0.0.1';
  return net.isIPv6(bind) ? `[${bind}]` : bind;
};
const dashUrl = (cfg) => `http://${callHost(cfg.bind)}:${cfg.port}`;

async function healthy(cfg, timeoutMs = 2000) {
  try {
    // Only the address the server was told to bind: a wildcard is called on 127.0.0.1, and a bind that is neither an IP address nor a plain host name is refused (CodeQL js/file-access-to-http).
    if (!net.isIP(cfg.bind.replace(/^\[|\]$/g, '')) && !/^[A-Za-z0-9.-]+$/.test(cfg.bind)) return false;
    const r = await fetch(`${dashUrl(cfg)}/api/fleet/state`, { signal: AbortSignal.timeout(timeoutMs) });
    return r.ok;
  } catch { return false; }
}
/** Waits for the server to answer. `abort` lets a caller stop early, e.g. when the process it spawned has exited. */
async function waitHealthy(cfg, seconds = 30, abort = () => false) {
  for (let i = 0; i < seconds * 2; i++) {
    if (abort()) return false;
    if (await healthy(cfg, 1000)) return !abort();
    await new Promise((r) => setTimeout(r, 500));
  }
  return false;
}

/** True if something accepts TCP connections on the configured bind address and port. */
function portInUse(cfg, timeoutMs = 1000) {
  return new Promise((resolve) => {
    const sock = net.connect({ host: callHost(cfg.bind).replace(/^\[|\]$/g, ''), port: cfg.port });
    const done = (used) => { sock.destroy(); resolve(used); };
    sock.setTimeout(timeoutMs, () => done(false));
    sock.once('connect', () => done(true));
    sock.once('error', () => done(false));
  });
}

/** The last lines of the standalone server log, for a failed start. */
function logTail(from = 0, lines = 15) {
  try { return fs.readFileSync(logPath()).subarray(from).toString('utf8').trimEnd().split('\n').slice(-lines).join('\n'); } catch { return ''; }
}

// ---------- container engine (podman or docker) ----------

/** Runs the container engine. Podman and Docker take the same arguments for everything podiumctl does. */
function ce(engine, args, opts = {}) {
  return spawnSync(engine, args, { encoding: 'utf8', ...opts });
}
const engineInstalled = (engine) => !!engine && spawnSync(engine, ['--version'], { stdio: 'ignore' }).status === 0;
function ensureEngine(cfg) {
  const { engine } = cfg;
  if (!engine) fail('neither podman nor docker is installed (or on PATH). Install one, or use --mode standalone.');
  if (!engineInstalled(engine)) fail(`${engine} is not installed (or not on PATH). Install it, choose another --engine, or use --mode standalone.`);
  let info = ce(engine, ['info']);
  if (info.status === 0) return;
  if (engine === 'podman' && (process.platform === 'darwin' || process.platform === 'win32')) {
    say('Podman machine is not running; starting it...');
    if (ce(engine, ['machine', 'start'], { stdio: 'inherit' }).status === 0 && (info = ce(engine, ['info'])).status === 0) return;
  }
  // Show the engine's own reason: a stopped daemon and a socket this user may not open (not in the docker group) need different fixes.
  const why = (info.stderr ?? '').trim().split('\n').slice(-3).join('\n');
  fail(`${engine} is not usable (\`${engine} info\` fails)${engine === 'docker' ? '. Is Docker Desktop or the Docker daemon running, and may you use it?' : '.'}${why ? `\n${why}` : ''}`);
}
const containerState = (engine) => {
  const r = ce(engine, ['container', 'inspect', CONTAINER, '--format', '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}']);
  return r.status === 0 ? r.stdout.trim() : null;
};
/** Another installed engine that runs the podium container, e.g. Podman's while cfg.engine is now docker. */
const otherEngineRunning = (cfg) => installedEngines().find((e) => e !== cfg.engine && /^running/.test(containerState(e) ?? ''));

// ---------- TLS folder ----------

/** The folder that holds a CA: only its owner may open it, because it holds the CA key. */
function makePrivateDir(dir) {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  // Rootless Podman's :U hands the folder to a mapped user, and then the host user may not chmod it; it is private already.
  try { fs.chmodSync(dir, 0o700); } catch (e) { if (e.code !== 'EPERM' && e.code !== 'EACCES') throw e; }
}
/** The warning for a started container, from its mounts; says nothing when the engine cannot be asked. */
function checkTlsStorage(cfg) {
  const r = ce(cfg.engine, ['container', 'inspect', CONTAINER, '--format', '{{json .Mounts}}']);
  if (r.status !== 0) return;
  let mounts = [];
  try { mounts = JSON.parse(r.stdout); } catch { return; }
  const warning = tlsStorageWarning(Array.isArray(mounts) ? mounts : []);
  if (warning) console.error(`podiumctl: warning: ${warning}`);
}

// ---------- standalone ----------

function readPid() {
  try {
    const pid = Number(fs.readFileSync(pidPath(), 'utf8'));
    process.kill(pid, 0);
    // A stale pid file can name a reused pid; only trust a process that is ours.
    const cmd = spawnSync('ps', ['-p', String(pid), '-o', 'command='], { encoding: 'utf8' }).stdout;
    return /podiumctl|server\/dist\/index\.js/.test(cmd) ? pid : null;
  } catch { return null; }
}
const serverEntry = () => path.join(REPO_ROOT, 'server', 'dist', 'index.js');

function standaloneEnv(cfg) {
  const env = { ...process.env, ...serverEnv(cfg, false) };
  if (!env.PODIUM_DB) env.PODIUM_DB = path.join(homeDir(), 'data', 'podium.sqlite');
  // The server keeps its TLS CA in PODIUM_DATA_DIR, else the folder of a SQLite file. A database on the network has no
  // such folder, so it gets the same default folder the SQLite file would have.
  if (!env.PODIUM_DATA_DIR) env.PODIUM_DATA_DIR = isNetworkDb(env.PODIUM_DB) ? path.join(homeDir(), 'data') : path.dirname(env.PODIUM_DB);
  fs.mkdirSync(env.PODIUM_DATA_DIR, { recursive: true });
  if (!isNetworkDb(env.PODIUM_DB)) fs.mkdirSync(path.dirname(env.PODIUM_DB), { recursive: true });
  if (cfg.tls) makePrivateDir(path.join(env.PODIUM_DATA_DIR, 'tls'));
  return env;
}
function requireBuilt() {
  if (!fs.existsSync(serverEntry()) || !fs.existsSync(path.join(REPO_ROOT, 'frontend', 'dist', 'index.html'))) {
    fail('the app is not built. Run: podiumctl build --mode standalone');
  }
}

// ---------- commands ----------

/**
 * The build a footer shows (#400): the 8-character commit hash, with `-dirty` after it when the tree has local edits, and
 * nothing for a release. A release is a clean checkout of exactly a vMAJOR.MINOR.PATCH tag; every other commit is a dev build,
 * whatever its branch. Nothing at all (no git) means the footer shows the version alone.
 */
export function buildId({ hash, tag, dirty }) {
  if (!hash) return '';
  if (!dirty && /^v\d+\.\d+\.\d+$/.test(tag)) return '';
  return dirty ? `${hash}-dirty` : hash;
}

/** buildId() for the checkout at `cwd`; empty when it is not a git checkout or git is missing. */
export function gitBuild(cwd) {
  const git = (...args) => spawnSync('git', args, { cwd, encoding: 'utf8' });
  const head = git('rev-parse', '--short=8', 'HEAD');
  if (head.status !== 0) return '';
  const tag = git('describe', '--exact-match', '--tags', 'HEAD');
  const status = git('status', '--porcelain');
  return buildId({ hash: head.stdout.trim(), tag: tag.status === 0 ? tag.stdout.trim() : '', dirty: status.status === 0 && status.stdout.trim() !== '' });
}

async function cmdBuild(cfg) {
  const build = gitBuild(REPO_ROOT);
  if (cfg.mode === 'container') {
    ensureEngine(cfg);
    const r = ce(cfg.engine, ['build', '--build-arg', `PODIUM_BUILD=${build}`, '-t', IMAGE, '-f', path.join(REPO_ROOT, 'Containerfile'), REPO_ROOT], { stdio: 'inherit' });
    if (r.status !== 0) fail('image build failed');
    say(`Built ${IMAGE} with ${cfg.engine}${build ? ` (dev build ${build})` : ''}`);
  } else {
    const run = (args) => { if (spawnSync('npm', args, { cwd: REPO_ROOT, stdio: 'inherit' }).status !== 0) fail(`npm ${args.join(' ')} failed`); };
    if (!fs.existsSync(path.join(REPO_ROOT, 'node_modules'))) run(['install']);
    run(['run', 'build', '-w', 'frontend']);
    run(['run', 'build', '-w', 'server']);
    // The server reads this at start, where the container reads PODIUM_BUILD; a release writes null.
    fs.writeFileSync(path.join(REPO_ROOT, 'server', 'build.json'), `${JSON.stringify({ build: build || null })}\n`);
    say(`Built the app${build ? ` (dev build ${build})` : ''}`);
  }
}

function otherModeRunning(cfg) {
  if (cfg.mode === 'container') return readPid() ? 'standalone' : null;
  // Check every engine, not only the saved one: a container either of them runs holds the port.
  return installedEngines().some((e) => /^running/.test(containerState(e) ?? '')) ? 'container' : null;
}

async function cmdStart(cfg) {
  const other = otherModeRunning(cfg);
  if (other) fail(`Podium is already running in ${other} mode. Stop it first (podiumctl stop --mode ${other}).`);
  cfg = ensureToken(cfg);
  let exited = false; // set when the standalone server we spawned exits
  let logFrom = 0;    // size of podium.log before this start, so a failure shows only this run's output
  if (cfg.mode === 'container') {
    ensureEngine(cfg);
    if ((containerState(cfg.engine) ?? '').startsWith('running')) { say(`Already running at ${dashUrl(cfg)} (use restart to apply config changes)`); return; }
    const elsewhere = otherEngineRunning(cfg);
    if (elsewhere) fail(`Podium is already running under ${elsewhere}. Stop it first (podiumctl stop --engine ${elsewhere}).`);
    // `image inspect`, not `image exists`: Docker has no `image exists`.
    if (ce(cfg.engine, ['image', 'inspect', IMAGE], { stdio: 'ignore' }).status !== 0) { say('No image yet; building it...'); await cmdBuild(cfg); }
    ce(cfg.engine, ['rm', '-f', CONTAINER], { stdio: 'ignore' });
    const env = serverEnv(cfg, true);
    if (cfg.tls) makePrivateDir(tlsDirPath());
    const r = ce(cfg.engine, containerRunArgs(cfg, Object.keys(env), tlsDirPath()), { env: { ...process.env, ...env }, stdio: ['ignore', 'ignore', 'inherit'] });
    if (r.status !== 0) fail(`${cfg.engine} run failed`);
    if (cfg.tls) checkTlsStorage(cfg);
  } else {
    if (readPid()) { say(`Already running at ${dashUrl(cfg)}`); return; }
    if (await portInUse(cfg)) {
      fail(`port ${cfg.port} on ${cfg.bind} is already in use by another process, so a new Podium could not start. Run \`podiumctl status\` to see whether it is Podium, or choose another port with --port.`);
    }
    requireBuilt();
    fs.mkdirSync(homeDir(), { recursive: true });
    const out = fs.openSync(logPath(), 'a');
    logFrom = fs.fstatSync(out).size;
    const child = spawn(process.execPath, [serverEntry()], { cwd: REPO_ROOT, env: standaloneEnv(cfg), detached: true, stdio: ['ignore', out, out] });
    child.unref();
    child.once('exit', () => { exited = true; });
    fs.writeFileSync(pidPath(), String(child.pid));
  }
  // Only report success for the process we spawned: if it exits while we wait, whatever answers is not ours.
  const up = await waitHealthy(cfg, 30, () => exited);
  if (exited) {
    fs.rmSync(pidPath(), { force: true });
    const tail = logTail(logFrom);
    fail(`the server exited right after starting.${tail ? `\nLast lines of ${logPath()}:\n${tail}` : ''}`);
  }
  if (!up) fail(`started, but the server did not answer at ${dashUrl(cfg)}. See: podiumctl logs`);
  say(`Podium is up at ${dashUrl(cfg)}  (${cfg.mode} mode${cfg.mode === 'container' ? `, ${cfg.engine}` : ''})`);
  if (cfg.tls) say(`TLS is on: reporters connect on port ${cfg.tlsPort} with their certificate (mutual TLS only); the console stays on HTTP port ${cfg.port}. The CA is kept in ${cfg.mode === 'container' ? tlsDirPath() : path.join(standaloneEnv(cfg).PODIUM_DATA_DIR, 'tls')}; back it up and keep it private.`);
}

async function cmdStop(cfg) {
  if (cfg.mode === 'container') {
    ensureEngine(cfg);
    if (containerState(cfg.engine) === null) {
      const elsewhere = otherEngineRunning(cfg);
      say(elsewhere ? `Not running under ${cfg.engine}, but it is under ${elsewhere}: podiumctl stop --engine ${elsewhere}` : 'Not running');
      return;
    }
    if (ce(cfg.engine, ['stop', '-t', '10', CONTAINER], { stdio: ['ignore', 'ignore', 'inherit'] }).status !== 0) fail(`${cfg.engine} stop failed`);
    say('Stopped');
    return;
  }
  const pid = readPid();
  if (!pid) { say('Not running'); fs.rmSync(pidPath(), { force: true }); return; }
  process.kill(pid, 'SIGTERM');
  for (let i = 0; i < 20; i++) {
    await new Promise((r) => setTimeout(r, 250));
    if (!readPid()) { fs.rmSync(pidPath(), { force: true }); say('Stopped'); return; }
  }
  process.kill(pid, 'SIGKILL');
  fs.rmSync(pidPath(), { force: true });
  say('Did not stop within 5 s; killed');
}

async function cmdStatus(cfg) {
  const lines = [`mode:     ${cfg.mode}`];
  let running = false;
  if (cfg.mode === 'container') {
    lines.push(`engine:   ${cfg.engine ?? 'none (install podman or docker)'}`);
    if (!engineInstalled(cfg.engine)) lines.push(`state:    ${cfg.engine ?? 'container engine'} not installed`);
    else if (ce(cfg.engine, ['info'], { stdio: 'ignore' }).status !== 0) lines.push(`state:    ${cfg.engine === 'podman' ? 'podman machine not running' : 'docker not usable (see `docker info`)'}`);
    else {
      const st = containerState(cfg.engine);
      running = !!st?.startsWith('running');
      lines.push(`state:    ${st ? `container ${st.trim()}` : 'no container'}`);
    }
  } else {
    const pid = readPid();
    running = !!pid;
    lines.push(`state:    ${pid ? `running (pid ${pid})` : 'stopped'}`);
  }
  const ok = running && (await healthy(cfg));
  lines.push(`health:   ${running ? (ok ? 'answering' : 'not answering') : '-'}`);
  lines.push(`url:      ${dashUrl(cfg)}`);
  if (isNetworkDb(cfg.db)) lines.push(`database: ${dbLabel(cfg.db)}`);
  lines.push(`tls:      ${cfg.tls ? `on (reporter port ${cfg.tlsPort}, mutual TLS)` : 'off'}`);
  lines.push(`token:    ${cfg.token === undefined ? 'not generated yet (created on first start)' : cfg.token === '' ? 'none (auth off)' : 'set (podiumctl token)'}`);
  lines.push(`on boot:  ${bootState()}`);
  lines.push(`config:   ${configPath()}`);
  say(lines.join('\n'));
  return running ? 0 : 3;
}

function cmdLogs(cfg, flags) {
  const tail = String(flags.tail ?? 100);
  let r;
  if (cfg.mode === 'container') {
    ensureEngine(cfg);
    r = ce(cfg.engine, ['logs', '--tail', tail, ...(flags.follow ? ['--follow'] : []), CONTAINER], { stdio: 'inherit' });
  } else {
    if (!fs.existsSync(logPath())) fail(`no log yet (${logPath()})`);
    r = spawnSync('tail', ['-n', tail, ...(flags.follow ? ['-f'] : []), logPath()], { stdio: 'inherit' });
  }
  return r.status ?? 0;
}

function cmdToken(flags) {
  const file = readConfigFile();
  if (flags.rotate) {
    const token = randomBytes(24).toString('hex');
    writeConfigFile({ ...file, PODIUM_TOKEN: token });
    sayRequested(token);
    console.error('New admin secret saved. Restart the server (podiumctl restart). Only reporters that send the admin secret need the new value; people\'s own tokens keep working.');
  } else if (file.PODIUM_TOKEN === undefined) fail('no token yet; it is generated on the first `podiumctl start`');
  else if (file.PODIUM_TOKEN === '') fail('auth is off (PODIUM_TOKEN is empty)');
  else sayRequested(file.PODIUM_TOKEN);
}

function cmdConfig(cfg, args, flags) {
  const file = readConfigFile();
  if (args[0] === 'set' || args[0] === 'unset') {
    const set = args[0] === 'set';
    const items = args.slice(1);
    if (!items.length) fail(set ? 'usage: podiumctl config set KEY=VALUE [KEY=VALUE ...]' : 'usage: podiumctl config unset KEY [KEY ...]');
    // Each argument is one pair (set) or one key (unset). Check all of them before changing anything.
    const next = { ...file };
    const keys = [];
    for (const item of items) {
      const eq = item.indexOf('=');
      if (set && eq < 0) fail(`"${item}" is not KEY=VALUE. usage: podiumctl config set KEY=VALUE [KEY=VALUE ...]`);
      const key = (set ? item.slice(0, eq) : item).trim();
      if (RETIRED_KEYS.includes(key)) {
        if (set) fail(`${key} is no longer used (the usage dashboard was removed). Use \`podiumctl config unset ${key}\` to clear an old value.`);
      } else if (!ALL_KEYS.includes(key)) fail(`unknown key "${key}". Keys: ${ALL_KEYS.join(', ')}`);
      if (set) next[key] = item.slice(eq + 1);
      else delete next[key];
      if (!keys.includes(key)) keys.push(key);
    }
    if (set) resolveConfig(next); // validate mode/engine/port
    writeConfigFile(next);
    say(`${set ? 'Set' : 'Unset'} ${keys.join(', ')}. Run \`podiumctl restart\` to apply.`);
    return;
  }
  const shown = flags['show-token'] ? { ...file } : maskConfig(file);
  say(`# ${configPath()}\n# resolved: mode=${cfg.mode}${cfg.mode === 'container' ? ` engine=${cfg.engine ?? 'none'}` : ''} port=${cfg.port} bind=${cfg.bind}`);
  const lines = Object.entries(shown).map(([k, v]) => `${k}=${v}`).join('\n') || '(no settings saved yet)';
  if (flags['show-token']) sayRequested(lines);
  else say(lines);
}

function servicePaths() {
  return process.platform === 'darwin'
    ? { kind: 'launchd', file: path.join(os.homedir(), 'Library', 'LaunchAgents', `${SERVICE_LABEL}.plist`) }
    : { kind: 'systemd', file: path.join(os.homedir(), '.config', 'systemd', 'user', 'podium.service') };
}
const bootEnabled = () => fs.existsSync(servicePaths().file);

/** True when a boot unit's text does not name `script` (a unit written before the file was renamed still names the old .mjs file). */
export function bootUnitStale(text, script) {
  const names = (s) => new RegExp(`(?<![\\w.-])${s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\w.-])`).test(text);
  // launchd plists XML-escape paths, so a path with & or < is written escaped
  return !(names(script) || names(script.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')));
}

function bootState() {
  if (!bootEnabled()) return 'disabled';
  const script = fs.realpathSync(fileURLToPath(import.meta.url));
  return bootUnitStale(fs.readFileSync(servicePaths().file, 'utf8'), script) ? 'enabled, but stale (points at an old path; run `podiumctl enable` to rewrite it)' : 'enabled';
}

function cmdEnable(cfg) {
  const { kind, file } = servicePaths();
  const standalone = cfg.mode === 'standalone';
  const script = fs.realpathSync(fileURLToPath(import.meta.url));
  const stable = stableNodePath(process.execPath);
  // only trust the rewrite when it still leads to this node
  const node = stable !== process.execPath && fs.existsSync(stable) && fs.realpathSync(stable) === fs.realpathSync(process.execPath) ? stable : process.execPath;
  const modeArgs = ['--mode', cfg.mode, ...(standalone || !cfg.engine ? [] : ['--engine', cfg.engine])];
  const args = [node, script, standalone ? 'run' : 'start', ...modeArgs];
  const env = { PATH: process.env.PATH ?? '', ...(process.env.PODIUMCTL_HOME ? { PODIUMCTL_HOME: process.env.PODIUMCTL_HOME } : {}) };
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.mkdirSync(homeDir(), { recursive: true });
  if (kind === 'launchd') {
    fs.writeFileSync(file, launchdPlist({ label: SERVICE_LABEL, args, keepAliveOnFailure: standalone, logPath: path.join(homeDir(), 'service.log'), env }));
    const domain = `gui/${os.userInfo().uid}`;
    spawnSync('launchctl', ['bootout', `${domain}/${SERVICE_LABEL}`], { stdio: 'ignore' });
    if (spawnSync('launchctl', ['bootstrap', domain, file], { stdio: 'inherit' }).status !== 0) fail('launchctl bootstrap failed');
    say(`Enabled: ${file}`);
  } else {
    fs.writeFileSync(file, systemdUnit({ args, stopArgs: [node, script, 'stop', ...modeArgs], standalone, env }));
    const sc = (a) => spawnSync('systemctl', ['--user', ...a], { stdio: 'inherit' }).status === 0;
    if (!sc(['daemon-reload']) || !sc(['enable', '--now', 'podium.service'])) fail('systemctl failed');
    say(`Enabled: ${file}\nTo start before you log in: loginctl enable-linger $USER`);
  }
  say(`Podium (${cfg.mode} mode) now starts on boot/login.`);
}

function cmdDisable() {
  const { kind, file } = servicePaths();
  if (!fs.existsSync(file)) { say('Not enabled'); return; }
  if (kind === 'launchd') spawnSync('launchctl', ['bootout', `gui/${os.userInfo().uid}/${SERVICE_LABEL}`], { stdio: 'ignore' });
  else {
    spawnSync('systemctl', ['--user', 'disable', '--now', 'podium.service'], { stdio: 'ignore' });
  }
  fs.rmSync(file, { force: true });
  if (kind === 'systemd') spawnSync('systemctl', ['--user', 'daemon-reload'], { stdio: 'ignore' });
  // systemd's `disable --now` runs ExecStop, so a container stops too; launchd's bootout only ends a standalone server
  say(kind === 'systemd'
    ? 'Disabled. The server the service was running is stopped with it; check `podiumctl status`.'
    : 'Disabled. Check `podiumctl status`: a server the service was running (standalone mode) is stopped with it.');
}

async function cmdRun(cfg) {
  cfg = ensureToken(cfg);
  requireBuilt();
  const child = spawn(process.execPath, [serverEntry()], { cwd: REPO_ROOT, env: standaloneEnv(cfg), stdio: 'inherit' });
  // Record this wrapper's pid, not the server's: `stop` must reach the SIGTERM handler below so the
  // wrapper exits 0 and the boot service (KeepAlive/Restart=on-failure) does not restart the server.
  fs.writeFileSync(pidPath(), String(process.pid));
  let stopping = false;
  for (const sig of ['SIGTERM', 'SIGINT']) process.on(sig, () => { stopping = true; child.kill(sig); });
  child.on('exit', (code, signal) => {
    fs.rmSync(pidPath(), { force: true });
    process.exit(stopping ? 0 : code ?? (signal ? 1 : 0));
  });
}

function cmdRm(cfg, flags) {
  // Refuse before anything is removed, so a forgotten --yes leaves the container as it was.
  if (flags['purge-tls'] && !flags.yes) fail('--purge-tls deletes the CA, so every reporter config must be reissued. Re-run with --purge-tls --yes to confirm.');
  ensureEngine(cfg);
  ce(cfg.engine, ['rm', '-f', CONTAINER], { stdio: 'ignore' });
  say('Container removed (the data volume is kept).');
  if (flags.purge) {
    if (!flags.yes) fail('--purge deletes the database and the image. Re-run with --purge --yes to confirm.');
    say('--purge deletes the database (the data volume) and the image.');
    ce(cfg.engine, ['volume', 'rm', '-f', VOLUME], { stdio: 'ignore' });
    ce(cfg.engine, ['rmi', '-f', IMAGE], { stdio: 'ignore' });
    say('Volume and image removed.');
  }
  const tlsDir = tlsDirPath();
  if (!fs.existsSync(tlsDir)) return;
  if (flags['purge-tls']) {
    try { fs.rmSync(tlsDir, { recursive: true, force: true }); } catch (e) {
      fail(`could not delete ${tlsDir} (${e.code}). Rootless Podman gave the folder to the container's user; delete it with: ${cfg.engine} unshare rm -rf ${tlsDir}`);
    }
    say(`${tlsDir} deleted: the CA is gone, so every reporter config must be reissued.`);
  } else say(`${tlsDir} is kept: it holds the CA. Delete it with --purge-tls --yes, which means every reporter config must be reissued.`);
}

// ---------- contexts (#606) ----------
// A context names one reporter config file, kept in contexts.json beside config.env. The reporter (mod/podium-reporter/hooks/contexts.ts)
// reads the same file; scripts/podiumctl.test.ts checks that the two agree on the format.

export const CONTEXTS_FILE = 'contexts.json';
/** The reporter reads ~/.podium/contexts.json and knows nothing of PODIUMCTL_HOME, so the contexts live there whatever it says. */
const reporterDir = () => path.join(os.homedir(), '.podium');
const CONTEXT_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/;
const CONTEXT_VERBS = ['list', 'show', 'add', 'rename', 'remove', 'use'];
const NEXT_SESSION = 'It applies from the next session; sessions already running keep the context they started with.';

const contextFileOk = (f) => typeof f === 'string' && f !== '' && !f.includes('\0') && (f.startsWith('/') ? !f.endsWith('/') : !f.includes('/') && f !== '.' && f !== '..');

/** The contexts in a file's text, or null when it is not a contexts file. A `current` that names no context is dropped. */
export function parseContexts(text) {
  let raw;
  try { raw = JSON.parse(text); } catch { return null; }
  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) return null;
  const { current, contexts } = raw;
  if (typeof contexts !== 'object' || contexts === null || Array.isArray(contexts)) return null;
  if (current !== undefined && current !== null && typeof current !== 'string') return null;
  for (const [name, file] of Object.entries(contexts)) if (!CONTEXT_NAME.test(name) || !contextFileOk(file)) return null;
  return { current: typeof current === 'string' && Object.hasOwn(contexts, current) ? current : null, contexts: { ...contexts } };
}

export function serializeContexts(c) {
  return `${JSON.stringify({ current: c.current, contexts: c.contexts }, null, 2)}\n`;
}

/** The headers of a reporter config file, or null when it is not a v1 file with a name, an https server and an issued-at line. */
export function configHeaders(text) {
  const lines = text.split(/\r?\n/);
  if (lines[0]?.trim() !== '# podium-reporter-config v1') return null;
  const h = new Map();
  for (const line of lines.slice(1)) {
    if (!line.startsWith('#')) break;
    const body = line.slice(1).trimStart();
    const colon = body.indexOf(':');
    const key = colon > 0 ? body.slice(0, colon) : '';
    if (/^[a-z-]+$/.test(key) && !h.has(key)) h.set(key, body.slice(colon + 1).trim());
  }
  const user = h.get('user');
  const server = h.get('server');
  const issuedAt = Number((h.get('issued-at') ?? '').split(/\s+/).pop());
  if (!user || !server || !Number.isFinite(issuedAt) || issuedAt <= 0) return null;
  try { if (new URL(server).protocol !== 'https:') return null; } catch { return null; }
  return { user, server };
}

/** One change to the contexts: [new contexts, what to say], or a Fail. `read` gives a config file's text or null. */
export function changeContexts(c, verb, args, read) {
  const [a, b] = args;
  const need = (n, usage) => { if (args.length !== n || args.some((x) => !x)) throw new Fail(`usage: podiumctl context ${usage}`); };
  const has = (n) => Object.hasOwn(c.contexts, n);
  const validName = (n) => { if (!CONTEXT_NAME.test(n)) throw new Fail(`"${n}" is not a usable context name. Use letters, digits, dots, dashes and underscores, starting with a letter or digit, up to 64 characters.`); };
  if (verb === 'add') {
    need(2, 'add <name> <config file>   (a file name in the Podium folder, or an absolute path)');
    validName(a);
    if (!contextFileOk(b)) throw new Fail(`"${b}" is not a config file name or an absolute path.`);
    if (has(a)) throw new Fail(`There is already a context named "${a}". Remove it first, or choose another name.`);
    const text = read(b);
    if (text === null) throw new Fail(`No such file: ${b.startsWith('/') ? b : path.join(reporterDir(), b)}. Nothing was added.`);
    if (!configHeaders(text)) throw new Fail(`${b} is not a Podium reporter config file (version 1, with a name, an https server and an issued-at line). Nothing was added.`);
    return [{ current: c.current ?? a, contexts: { ...c.contexts, [a]: b } }, [`Added context "${a}" for ${b}.`, c.current ? '' : `"${a}" is now the current context. ${NEXT_SESSION}`].filter(Boolean).join(' ')];
  }
  if (verb === 'rename') {
    need(2, 'rename <name> <new name>');
    if (!has(a)) throw new Fail(`There is no context named "${a}".`);
    validName(b);
    if (has(b)) throw new Fail(`There is already a context named "${b}".`);
    const contexts = {};
    for (const [n, f] of Object.entries(c.contexts)) contexts[n === a ? b : n] = f;
    return [{ current: c.current === a ? b : c.current, contexts }, `Renamed context "${a}" to "${b}".`];
  }
  if (verb === 'remove') {
    need(1, 'remove <name>');
    if (!has(a)) throw new Fail(`There is no context named "${a}".`);
    const contexts = { ...c.contexts };
    delete contexts[a];
    return [{ current: c.current === a ? null : c.current, contexts }, `Removed context "${a}" (its config file is untouched).${c.current === a ? ' It was the current context, so there is none now: the newest reporter config file is used.' : ''}`];
  }
  need(1, 'use <name>');
  if (!has(a)) throw new Fail(`There is no context named "${a}".`);
  return [{ ...c, current: a }, `The current context is now "${a}". ${NEXT_SESSION}`];
}

function cmdContext(args) {
  const [verb = 'list', ...rest] = args;
  if (!CONTEXT_VERBS.includes(verb)) fail(`unknown context command "${verb}". Use one of: ${CONTEXT_VERBS.join(', ')}.`);
  const file = path.join(reporterDir(), CONTEXTS_FILE);
  // One read, not an existence check and then a read: a file that appears or goes between the two is not a race this way.
  let fileText = null;
  try { fileText = fs.readFileSync(file, 'utf8'); } catch (e) { if (e.code !== 'ENOENT') fail(`${file} exists but cannot be read (${e.code}), so nothing was changed.`); }
  const contexts = fileText === null ? { current: null, contexts: {} } : parseContexts(fileText);
  if (!contexts) fail(`${file} is not a valid contexts file, so nothing was changed. Fix or delete it.`);
  const resolve = (f) => (f.startsWith('/') ? f : path.join(reporterDir(), f));
  const read = (f) => { try { return fs.readFileSync(resolve(f), 'utf8'); } catch { return null; } };
  const fromEnv = process.env.PODIUM_REPORTER_CONTEXT || undefined;
  const describe = (f) => {
    const text = read(f);
    if (text === null) return 'file missing';
    const h = configHeaders(text);
    return h ? `${h.user} at ${h.server.replace(/^https:\/\//, '')}` : 'not a Podium reporter config';
  };
  if (verb === 'list') {
    const names = Object.keys(contexts.contexts);
    if (!names.length) { say('No contexts. The newest reporter config file is used. Add one: podiumctl context add <name> <config file>'); return; }
    for (const n of names) say(`${n === contexts.current ? '*' : ' '} ${n}  ${describe(contexts.contexts[n])}${n === fromEnv ? '  (this terminal: PODIUM_REPORTER_CONTEXT)' : ''}`);
    say('');
    say(`* is the current context.${fromEnv ? ` PODIUM_REPORTER_CONTEXT in this terminal is "${fromEnv}" and wins over it.` : ''}`);
    return;
  }
  if (verb === 'show') {
    const which = rest[0] ?? fromEnv ?? contexts.current;
    if (!which) { say('There is no current context. The newest reporter config file is used.'); return; }
    const f = Object.hasOwn(contexts.contexts, which) ? contexts.contexts[which] : undefined;
    if (!f) fail(`There is no context named "${which}".`);
    say(`Context: ${which}${which === contexts.current ? ' (current)' : ''}${which === fromEnv ? ' (set by PODIUM_REPORTER_CONTEXT)' : ''}`);
    say(`File: ${resolve(f)}`);
    say(`Reports as: ${describe(f)}`);
    return;
  }
  const [next, message] = changeContexts(contexts, verb, rest, read);
  fs.mkdirSync(reporterDir(), { recursive: true });
  fs.writeFileSync(file, serializeContexts(next));
  say(message);
  if (verb === 'use' && fromEnv && fromEnv !== rest[0]) say(`PODIUM_REPORTER_CONTEXT is "${fromEnv}" in this terminal and wins over it here.`);
}

// ---------- main ----------

export async function main(argv) {
  const { cmd, args, flags } = parseArgs(argv);
  if (!cmd || flags.help || cmd === 'help') { say(HELP); return cmd || flags.help ? 0 : 1; }
  if (cmd === 'context') { cmdContext(args); return 0; }
  const persist = ['build', 'start', 'restart', 'enable'].includes(cmd);
  const cfg = loadCfg(flags, { persist });
  switch (cmd) {
    case 'build': await cmdBuild(cfg); return 0;
    case 'start': await cmdStart(cfg); return 0;
    case 'stop': await cmdStop(cfg); return 0;
    case 'restart': await cmdStop(cfg); await cmdStart(loadCfg({}, { persist: false })); return 0;
    case 'status': return cmdStatus(cfg);
    case 'logs': return cmdLogs(cfg, flags);
    case 'health': { const ok = await healthy(cfg); say(ok ? 'ok' : 'not answering'); return ok ? 0 : 1; }
    case 'url': say(dashUrl(cfg)); return 0;
    case 'token': cmdToken(flags); return 0;
    case 'config': cmdConfig(cfg, args, flags); return 0;
    case 'enable': cmdEnable(cfg); return 0;
    case 'disable': cmdDisable(); return 0;
    case 'run': await cmdRun(cfg); return null;
    case 'shell': ensureEngine(cfg); return ce(cfg.engine, ['exec', '-it', CONTAINER, '/bin/sh'], { stdio: 'inherit' }).status ?? 1;
    case 'rm': cmdRm(cfg, flags); return 0;
    default: console.error(`unknown command "${cmd}" (see --help)`); return 2;
  }
}

if (fs.realpathSync(process.argv[1] ?? '') === fs.realpathSync(fileURLToPath(import.meta.url))) {
  main(process.argv.slice(2)).then(
    (code) => { if (code !== null) process.exit(code); },
    (e) => { console.error(e instanceof Fail ? `podiumctl: ${e.message}` : e); process.exit(1); },
  );
}
